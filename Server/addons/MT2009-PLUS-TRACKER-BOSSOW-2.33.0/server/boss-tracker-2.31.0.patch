+
+// MT2009_BOSS_TRACKER_V1: read-only snapshot for the minimap panel.
+// Explicit map whitelist; include the four requested ordinary cave floors.
+static bool tracker_public_map(long mapIndex)
+{
+	switch (mapIndex)
+	{
+		case 1: case 3: case 4: case 21: case 23: case 24:
+		case 41: case 43: case 44: case 61: case 62: case 63:
+		case 64: case 65: case 67: case 68: case 70:
+		case 71: case 72: case 73: case 104:
+		case 301: case 302: case 303: case 304:
+		case 360: case 361: case 362:
+			return true;
+		default:
+			return false;
+	}
+}
+
+static DWORD tracker_mob_vnum(LPREGEN regen, int& kind)
+{
+	std::vector<DWORD> members;
+	regen_member_vnums(regen, members);
+	for (DWORD vnum : members)
+	{
+		const CMob* mob = CMobManager::instance().Get(vnum);
+		if (!mob)
+			continue;
+		if (mob->m_table.bType == CHAR_TYPE_STONE &&
+			((vnum >= 8000 && vnum < 9000) || vnum == 9677 || vnum == 9678))
+		{
+			kind = 2;
+			return vnum;
+		}
+		if (mob->m_table.bType == CHAR_TYPE_MONSTER &&
+			(mob->m_table.bRank >= MOB_RANK_BOSS || IsMiniBoss(vnum) || vnum == 2491))
+			return vnum;
+	}
+	return 0;
+}
+
+struct BossTrackerRow
+{
+	int kind;
+	DWORD vnum;
+	int alive;
+	DWORD target;
+	long seconds;
+	long x;
+	long y;
+};
+
+struct TrackerLivePositions
+{
+	std::map<std::pair<LPREGEN, DWORD>, std::pair<long, long>> byRegenRace;
+	void operator()(LPENTITY entity)
+	{
+		if (!entity || !entity->IsType(ENTITY_CHARACTER))
+			return;
+		LPCHARACTER mob = (LPCHARACTER)entity;
+		if (mob->IsDead() || !mob->GetRegen())
+			return;
+		byRegenRace[std::make_pair(mob->GetRegen(), mob->GetRaceNum())] =
+			std::make_pair(mob->GetX(), mob->GetY());
+	}
+};
+
+static void tracker_collect_rows(long mapIndex, std::vector<BossTrackerRow>& rows)
+{
+	if (!tracker_public_map(mapIndex))
+		return;
+	TrackerLivePositions live;
+	SECTREE_MANAGER::instance().for_each(mapIndex, live);
+	for (LPREGEN regen = regen_list; regen && rows.size() < 180; regen = regen->next)
+	{
+		if (regen->lMapIndex != mapIndex)
+			continue;
+		int kind = regen->tracker_kind;
+		if (!kind && !regen->is_boss_or_stone)
+			continue;
+		DWORD vnum = tracker_mob_vnum(regen, kind);
+		if (!kind || !vnum)
+			continue;
+		const DWORD target = regen_target_count(regen, false);
+		const int alive = MAX(0, regen->count);
+		const long seconds = regen->event ? MAX(0L, event_time(regen->event) / passes_per_sec) : -1;
+		long x = (regen->sx + regen->ex) / 2;
+		long y = (regen->sy + regen->ey) / 2;
+		auto liveIt = live.byRegenRace.find(std::make_pair(regen, vnum));
+		if (alive && liveIt != live.byRegenRace.end())
+		{
+			x = liveIt->second.first;
+			y = liveIt->second.second;
+		}
+		rows.push_back({kind, vnum, alive, target, seconds, x, y});
+	}
+	for (const auto& pair : SpecialSpawnManager::instance().m_map_specialSpawns)
+	{
+		if (rows.size() >= 180)
+			break;
+		const LPSPECIAL_SPAWN special = pair.second;
+		if (!special || special->mapIndex != (DWORD)mapIndex ||
+			(special->channel && special->channel != (DWORD)g_bChannel))
+			continue;
+		if (!special->reqEventFlag.empty() &&
+			quest::CQuestManager::instance().GetEventFlag(special->reqEventFlag.c_str()) < 1)
+			continue;
+		DWORD vnum = special->vnum;
+		if (special->spawnType == SPECIAL_SPAWN_GROUP)
+		{
+			CMobGroup* group = CMobManager::instance().GetGroup(vnum);
+			if (!group || group->GetMemberVector().empty())
+				continue;
+			vnum = 0;
+			for (DWORD member : group->GetMemberVector())
+			{
+				const CMob* candidate = CMobManager::instance().Get(member);
+				if (candidate &&
+					((candidate->m_table.bType == CHAR_TYPE_STONE &&
+						((member >= 8000 && member < 9000) || member == 9677 || member == 9678)) ||
+					 (candidate->m_table.bType == CHAR_TYPE_MONSTER &&
+						(candidate->m_table.bRank >= MOB_RANK_BOSS || IsMiniBoss(member) || member == 2491))))
+				{
+					vnum = member;
+					break;
+				}
+			}
+			if (!vnum)
+				continue;
+		}
+		int kind = 1;
+		const CMob* mob = CMobManager::instance().Get(vnum);
+		if (!mob)
+			continue;
+		if (mob->m_table.bType == CHAR_TYPE_STONE &&
+			((vnum >= 8000 && vnum < 9000) || vnum == 9677 || vnum == 9678))
+			kind = 2;
+		else if (mob->m_table.bType != CHAR_TYPE_MONSTER ||
+			(mob->m_table.bRank < MOB_RANK_BOSS && !IsMiniBoss(vnum) && vnum != 2491))
+			continue;
+		const int alive = (int)special->GetSpawnCount();
+		const DWORD now = get_global_time();
+		const long seconds = alive ? 0 :
+			(special->end_event_time > now ? special->end_event_time - now : 0);
+		if (special->m_vec_spawnPositions.empty())
+			continue;
+		long x = special->m_vec_spawnPositions.front().pos.x;
+		long y = special->m_vec_spawnPositions.front().pos.y;
+		if (alive)
+		{
+			for (const auto& spawn : special->m_vec_spawnPositions)
+			{
+				LPCHARACTER current = CHARACTER_MANAGER::instance().Find(spawn.spawnVID);
+				if (current && !current->IsDead() && current->GetRaceNum() == vnum)
+				{
+					x = current->GetX();
+					y = current->GetY();
+					break;
+				}
+			}
+		}
+		rows.push_back({kind, vnum, alive, special->maxSpawnCount, seconds, x, y});
+	}
+}
+
+void regen_send_boss_tracker(LPCHARACTER ch)
+{
+	if (!ch || !ch->IsPC())
+		return;
+	const long mapIndex = ch->GetMapIndex();
+	ch->ChatPacket(CHAT_TYPE_COMMAND, "BTRACK begin %ld %d", mapIndex, g_bChannel);
+	std::vector<BossTrackerRow> rows;
+	tracker_collect_rows(mapIndex, rows);
+	LPSECTREE_MAP map = SECTREE_MANAGER::instance().GetMap(mapIndex);
+	if (map)
+	{
+		for (size_t i = 0; i < rows.size(); ++i)
+		{
+			const BossTrackerRow& row = rows[i];
+			ch->ChatPacket(CHAT_TYPE_COMMAND, "BTRACK row %d %u %d %u %ld %ld %ld %u",
+				row.kind, row.vnum, row.alive, row.target, row.seconds,
+				(row.x - map->m_setting.iBaseX) / 100,
+				(row.y - map->m_setting.iBaseY) / 100, (unsigned int)(i + 1));
+		}
+	}
+	ch->ChatPacket(CHAT_TYPE_COMMAND, "BTRACK end");
+}
+
+bool regen_boss_tracker_teleport(LPCHARACTER ch, unsigned int slot)
+{
+	if (!ch || !ch->IsPC() || !slot || slot > 180)
+		return false;
+	std::vector<BossTrackerRow> rows;
+	const long mapIndex = ch->GetMapIndex();
+	tracker_collect_rows(mapIndex, rows);
+	if (slot > rows.size())
+		return false;
+	const BossTrackerRow& row = rows[slot - 1];
+	if (row.alive < 1)
+		return false;
+	PIXEL_POSITION safe = {};
+	if (!SECTREE_MANAGER::instance().GetMovablePosition(mapIndex, row.x + 200, row.y + 200, safe))
+		return false;
+	return ch->WarpSet(safe.x, safe.y, mapIndex);
+}
