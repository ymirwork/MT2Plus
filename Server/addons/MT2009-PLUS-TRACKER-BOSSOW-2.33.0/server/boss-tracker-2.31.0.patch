+// MT2009_BOSS_TRACKER_V1: rate-limit each map, while a new map gets its
+// first snapshot immediately. The client polls every fifteen seconds.
+ACMD(do_boss_tracker)
+{
+	if (!ch || !ch->IsPC())
+		return;
+	static std::map<DWORD, std::pair<long, DWORD>> lastRequest;
+	const DWORD now = get_global_time();
+	const DWORD pid = ch->GetPlayerID();
+	const long mapIndex = ch->GetMapIndex();
+	auto it = lastRequest.find(pid);
+	if (it != lastRequest.end() && it->second.first == mapIndex &&
+		now >= it->second.second && now - it->second.second < 2)
+		return;
+	lastRequest[pid] = std::make_pair(mapIndex, now);
+	regen_send_boss_tracker(ch);
+}
+
+ACMD(do_boss_tracker_tp)
+{
+	if (!ch || !ch->IsPC())
+		return;
+	static std::map<DWORD, DWORD> lastTeleport;
+	const DWORD now = get_global_time();
+	const DWORD pid = ch->GetPlayerID();
+	auto it = lastTeleport.find(pid);
+	if (it != lastTeleport.end() && now >= it->second && now - it->second < 5)
+	{
+		ch->ChatPacket(CHAT_TYPE_INFO, "Kolejny teleport za %u s.", 5 - (now - it->second));
+		return;
+	}
+	if (ch->IsDead() || ch->IsStun() || ch->IsBusy() ||
+		ch->GetDungeon() || ch->GetWarMap() || !ch->CanWarp())
+	{
+		ch->ChatPacket(CHAT_TYPE_INFO, "Teleport jest teraz niedostepny.");
+		return;
+	}
+	char slotText[16];
+	one_argument(argument, slotText, sizeof(slotText));
+	unsigned int slot = 0;
+	if (!str_to_number(slot, slotText) || slot < 1 || slot > 180)
+		return;
+	if (regen_boss_tracker_teleport(ch, slot))
+		lastTeleport[pid] = now;
+	else
+		ch->ChatPacket(CHAT_TYPE_INFO, "Ten resp nie jest juz aktywny lub brak bezpiecznego miejsca TP.");
+}
 
