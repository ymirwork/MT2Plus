-- Pierscien Teleportacji (70058) is the Teleporter in the pocket. The package
-- drops the ring (mob_drop_item.txt, special_item_group.txt) and ships no quest
-- that answers its use, so using one did nothing ("nie dziala pierscien
-- teleportacji", 14 September). The list of destinations, the level floor and
-- the fee are the Teleporter's own (quest/npc/teleporter/map_warp.quest): the
-- same destinations from every map, including both home villages; dearer outside a
-- city. Seven additional destinations use the base fee from level 11.
-- The ring is not used up. Bots never come through here - they recall
-- home with it through TransitionPlayerBotMap, not through UseItem.
quest teleport_ring begin
    state start begin
        function data()
            return {
                low_level = {get_player_map1_index(), get_player_map2_index(), get_player_map3_index(), 64, 63, 61},
                high_level = {62, 66, 67, 68},
                additional = {65, 69, 70},
                dungeons = {({5, 25, 45})[pc.get_empire()], 108, 109, 104},
            }
        end

        function get_teleport_list(page)
            local available_teleports = teleport_ring.data()
            local map_lists = {
                available_teleports.low_level,
                available_teleports.dungeons,
                available_teleports.additional,
                available_teleports.high_level,
            }
            local map_list = map_lists[page]
            local pages = {1, 2, 3}
            if pc.get_level() >= 60 then
                pages = {1, 2, 3, 4}
            end

            local page_position = 1
            for i, page_number in ipairs(pages) do
                if page_number == page then
                    page_position = i
                end
            end
            local previous_page = pages[page_position - 1] or 0
            local next_page = pages[page_position + 1] or 0

            local options = {}
            for i, map_index in ipairs(map_list) do
                local map_name = translate.general.map_names[map_index]
                if map_index == 104 then
                    -- Polish letters use the client's cp1250 encoding.
                    map_name = "Kuahlo Dong (Loch Paj\185k\243w V1)"
                elseif map_index == 62 then
                    map_name = "Doyyumhwan (Ognista Ziemia)"
                elseif map_index == 3 then
                    map_name = "Strefa Yayang (M2)"
                elseif map_index == 5 or map_index == 25 or map_index == 45 then
                    map_name = "Hasun Dong (\163atwy Loch Ma\179p)"
                elseif map_index == 108 then
                    map_name = "Jungsun Dong (Normalny Loch Ma\179p)"
                elseif map_index == 109 then
                    map_name = "Sangsun Dong (Trudny Loch Ma\179p)"
                end
                table.insert(options, map_name)
            end
            local previous_index = 0
            local next_index = 0
            if previous_page > 0 then
                table.insert(options, translate.map_warp.previous)
                previous_index = table.getn(options)
            end
            if next_page > 0 then
                table.insert(options, translate.map_warp.next)
                next_index = table.getn(options)
            end
            table.insert(options, translate.general.cancel)
            local cancel_index = table.getn(options)
            return options, map_list, cancel_index, previous_index, next_index, previous_page, next_page
        end

        function process_teleport_list(current_page, base_price)
            while true do
                -- Only the original high-level destinations cost three times the base fee.
                local price = base_price * (current_page == 4 and 3 or 1)
                say_title(item_name(70058))
                say_split(translate.map_warp.talk2)
                say_reward(string.format(translate.map_warp.price, parse_number(price)))
                local select_list, map_list, cancel_index, previous_index, next_index, previous_page, next_page = teleport_ring.get_teleport_list(current_page)
                local x = select_table(select_list)
                if x == cancel_index then
                    return -1, 0
                elseif x == previous_index then
                    current_page = previous_page
                elseif x == next_index then
                    current_page = next_page
                else
                    return map_list[x], price
                end
            end
        end

        function check(price, player_level)
            if not pc.can_warp() then
                say_title(item_name(70058))
                say_split(translate.general.wait_after_exchange)
                say()
                return false
            end

            if player_level < 11 then
                say_title(item_name(70058))
                say_split(translate.map_warp.low_level)
                say()
                return false
            end

            if pc.get_gold() < price then
                say_title(item_name(70058))
                say_split(translate.map_warp.no_money)
                say_reward(string.format(translate.map_warp.price, parse_number(price)))
                say()
                return false
            end
            return true
        end

        -- Not 70058.use: special_item_group.txt puts the ring in the quest
        -- group 10031 ("Group ... Vnum 10031, Type Quest"), so ITEM_MANAGER
        -- gives every ring SIGVnum 10031 and the use goes to
        -- CQuestManager::SIGUse(10031), which looks for a sig_use handler
        -- under that number and never under the item's own. The handler below
        -- compiled and sat under 70058/use, where nothing ever looked, for
        -- 2.0.48-2.0.94 - found and fixed by Mur4s (22 September, "FIX
        -- PIERSCIONKA TELEPORTACJI"), confirmed by NerrVoVy.
        when 10031.sig_use begin
            local player_level = pc.get_level()
            -- The engine logs the use (QUEST_ITEM: use); this line says the
            -- handler itself ran, which no log said on 2.0.62-2.0.64.
            sys_log(0, string.format("QUEST_ITEM: teleport_ring runs name=%s level=%d map=%d", pc.get_name(), player_level, pc.get_map_index()))
            local is_in_any_city = is_player_in_any_m1() or is_player_in_any_m2()
            local base_price = math.max(math.floor(player_level / 5) * 1000, 1000)

            if pc.get_map_index() >= 181 and pc.get_map_index() <= 183 then -- empire war map
                base_price = 0
            elseif not is_in_any_city then
                base_price = base_price * 1.5
            end

            if not teleport_ring.check(base_price, player_level) then
                return
            end

            local map_index, price = teleport_ring.process_teleport_list(1, base_price)
            if map_index > 0 then
                if not teleport_ring.check(price, player_level) then
                    return
                end
                pc.change_money(-price)
                if map_index == 66 then
                    pc.warp(5900*100, 1114*100)
                else
                    pc.teleport(map_index)
                end
                return
            end
            setskin(NOWINDOW)
        end
    end
end
