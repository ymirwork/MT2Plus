-- MT2009_PLUS_BELTS_V1 - the belt system (Pasy). Autor: Digi Rasta (nowy-system v0.27.0,
-- SYSTEMY/pasy.md), ported into MT2009 PLUS. Mistrz (20082), beside the Blacksmith in M1
-- and M3 of every kingdom (spawned by the Dockerfile), opens the cube window with the nine
-- belt recipes of cube.pasy.txt. Odlamki Energii: quest energia_alchemik; Kamienie
-- Plomienia: the Razador and Nemere chests (special_item_group.dungeons.txt). The belts are
-- refined at the Blacksmith (refine_proto as it is); a belt's grade (value0) opens the
-- slots of the 4x4 belt inventory for potions (the client's belt window).
-- Dodano wytwarzanie Cor Draconis (3:1) - Opcja dialogowa u Mistrza.
-- cp1250; no literal ends with a Polish letter (qc).
quest pasy begin
	state start begin
		when 20082.chat."Wytwarzanie pasow" begin
			say_title(mob_name(20082)..":")
			say("Z kruszcow, perel i Odlamkow Energii")
			say("wykuje dla ciebie pas. Kazdy pas ma")
			say("kieszenie na mikstury - im wyzej go")
			say("ulepszysz u Kowala, tym wiecej kieszeni.")
			say("")
			say("Odlamki Energii wydobywa Alchemik")
			say("z rozebranych przedmiotow, a Kamienie")
			say("Plomienia znajdziesz w skrzyniach")
			say("Razadora i Nemere.")
			say("")
			if select("Otworz okno wytwarzania", "Anuluj") == 1 then
				setskin(NOWINDOW)
				cmdchat("CubeCategory belts")
				command("cube open")
			end
		end

		when 20082.chat."Wytwarzanie Cor Draconis" begin
			say_title(mob_name(20082)..":")
			say("Witaj! Jesli posiadasz Cor Draconis,")
			say("moge polaczyc je w cenniejsze smocze serca")
			say("o wyzszym stopniu szlifu.")
			say("")
			say("Wymiana odbywa sie w proporcji 3 do 1:")
			say("- 3x Cor Draconis -> 1x Cor Draconis (szlif.)")
			say("- 3x Cor Draconis (szlif.) -> 1x Cor Draconis (rzadkie)")
			say("- 3x Cor Draconis (rzadkie) -> 1x Cor Draconis (antyczne)")
			say("- 3x Cor Draconis (antyczne) -> 1x Cor Draconis (legend.)")
			say("")
			if select("Otworz okno wytwarzania", "Anuluj") == 1 then
				setskin(NOWINDOW)
				cmdchat("CubeCategory cors")
				command("cube open")
			end
		end
	end
end
