quest zdalny_biolog begin
	state start begin
		function get_current_mission()
			-- Tabela misji biologa: [lv] = { quest_name, item_vnum, required_count, key_vnum, name, min_lv }
			local missions = {
				{ "collect_quest_lv30", 30006, 10, 30220, "Zeby Orka (Lv. 30)", 30 },
				{ "collect_quest_lv40", 30047, 15, 30221, "Ksiegi Klatw (Lv. 40)", 40 },
				{ "collect_quest_lv50", 30015, 15, 30222, "Pamiatki po Demonie (Lv. 50)", 50 },
				{ "collect_quest_lv60", 30050, 20, 30223, "Matowe Lody (Lv. 60)", 60 },
				{ "collect_quest_lv70", 30165, 25, 30224, "Konary Zelkova (Lv. 70)", 70 },
				{ "collect_quest_lv80", 30166, 30, 30225, "Certyfikaty Tugyisa (Lv. 80)", 80 },
				{ "collect_quest_lv85", 30167, 40, 30226, "Czerwone Konary (Lv. 85)", 85 },
				{ "collect_quest_lv90", 30168, 50, 30227, "Notatki Przywodcy (Lv. 90)", 90 },
			}
			for i = 1, table.getn(missions) do
				local m = missions[i]
				local q_state = pc.getqf("state", m[1])
				-- Sprawdz czy gracz ma aktywny stan go_to_disciple lub key_item
				-- W silniku r40250 sprawdzamy stan w collect_quest
				if q_state != "__complete" and q_state != "start" and pc.get_level() >= m[6] then
					return m
				end
			end
			return nil
		end

		when login or levelup with pc.get_level() >= 30 begin
			set_state(information)
		end
	end

	state information begin
		when letter begin
			send_letter("Zdalny Biolog")
		end

		when button or info begin
			say_title("Zdalny Biolog Chaegirab:")
			say("Witaj poszukiwaczu!")
			say("Dzieki temu listowi mozesz oddawac badania")
			say("bez koniecznosci wracania do pierwszego miasta.")
			say("")

			local missions = {
				{ "collect_quest_lv30", 30006, 10, 30220, "Zeby Orka", 30 },
				{ "collect_quest_lv40", 30047, 15, 30221, "Ksiegi Klatw", 40 },
				{ "collect_quest_lv50", 30015, 15, 30222, "Pamiatki po Demonie", 50 },
				{ "collect_quest_lv60", 30050, 20, 30223, "Matowe Lody", 60 },
				{ "collect_quest_lv70", 30165, 25, 30224, "Konary Zelkova", 70 },
				{ "collect_quest_lv80", 30166, 30, 30225, "Certyfikaty Tugyisa", 80 },
				{ "collect_quest_lv85", 30167, 40, 30226, "Czerwone Konary", 85 },
				{ "collect_quest_lv90", 30168, 50, 30227, "Notatki Przywodcy", 90 },
			}

			local active_idx = 0
			for i = 1, table.getn(missions) do
				local m = missions[i]
				-- Sprawdzamy czy quest jest w toku (collect_count w danym quescie lub stan)
				-- W Metin2 flaga collect_count jest zapisana w ramach danego questa: pc.getqf("collect_count", m[1])
				-- Sprawdzamy stan misji przez qf lub poziom:
				if pc.get_level() >= m[6] then
					-- jesli gracz zakonczyl dana misje, nastepna staje sie aktywna
					-- Sprawdzamy czy oddaje przedmioty czy kamien duszy
					local count = pc.getqf("collect_count", m[1])
					if count != nil then
						active_idx = i
					end
				end
			end

			local choices = {
				"Oddaj przedmiot badania",
				"Oddaj Kamien Duszy (Kamien badania)",
				"Sprawdz stan badan",
				"Zamknij"
			}
			local s = select_table(choices)

			if s == 1 then
				-- Oddawanie glownego przedmiotu
				local found = false
				for i = 1, table.getn(missions) do
					local m = missions[i]
					if pc.count_item(m[2]) > 0 and pc.get_level() >= m[6] then
						found = true
						say_title("Zdalny Biolog:")
						say("Posiadasz: " .. item_name(m[2]) .. " x" .. pc.count_item(m[2]))
						say("Badanie: " .. m[5])
						say("")
						say("Czy chcesz przekazac 1 sztuke do badania?")
						if select("Przekaz przedmiot", "Anuluj") == 1 then
							if pc.count_item(m[2]) < 1 then
								say_title("Zdalny Biolog:")
								say("Nie posiadasz tego przedmiotu!")
								return
							end
							if collect_data != nil and collect_data.is_wait != nil and collect_data.is_wait() then
								say_title("Zdalny Biolog:")
								say("Badanie jest jeszcze analizowane!")
								collect_data.say_delay()
								return
							end

							pc.remove_item(m[2], 1)
							wait()

							local cur = pc.getqf("collect_count", m[1])
							if cur == nil then cur = 0 end

							local passed = true
							if collect_data != nil and collect_data.take_chance != nil then
								passed = collect_data.take_chance(60)
							else
								passed = number(1, 100) <= 60
							end

							if passed then
								if cur < (m[3] - 1) then
									pc.setqf("collect_count", cur + 1, m[1])
									say_title("Zdalny Biolog:")
									say("Doskonale! Przedmiot jest swietnej jakosci.")
									say("Zostalo jeszcze do oddania: " .. (m[3] - (cur + 1)) .. " szt.")
								else
									pc.setqf("collect_count", 0, m[1])
									if collect_data != nil and collect_data.reset_time != nil then
										collect_data.reset_time()
									end
									say_title("Zdalny Biolog:")
									say("Wspaniale! Zebrales juz wszystkie wymagane probki!")
									say("Teraz potrzebuje specjalnego Kamienia Duszy dla tego badania.")
									say("Wroc do Biologa osobiscie lub oddaj kamien zdalnie!")
								end
							else
								say_title("Zdalny Biolog:")
								say("Niestety ta probka byla zepsuta i nie nadaje sie do badan.")
							end
						end
						return
					end
				end
				if not found then
					say_title("Zdalny Biolog:")
					say("Nie posiadasz przy sobie zadnych przedmiotów do aktualnego badania!")
				end
			elseif s == 2 then
				-- Oddawanie kamienia kluczowego
				local found_key = false
				for i = 1, table.getn(missions) do
					local m = missions[i]
					if pc.count_item(m[4]) > 0 and pc.get_level() >= m[6] then
						found_key = true
						say_title("Zdalny Biolog:")
						say("Posiadasz: " .. item_name(m[4]))
						say("Czy chcesz go przekazac do dokonczenia badania?")
						if select("Przekaz kamien", "Anuluj") == 1 then
							if pc.count_item(m[4]) < 1 then
								say_title("Zdalny Biolog:")
								say("Nie posiadasz tego kamienia!")
								return
							end
							pc.remove_item(m[4], 1)
							say_title("Zdalny Biolog:")
							say("Niesamowite! Kamien idealnie pasuje do zakonczenia badan!")
							say("Udaj sie do Baek-Go lub Biologa, aby odebrac swoja stala nagrode!")
						end
						return
					end
				end
				if not found_key then
					say_title("Zdalny Biolog:")
					say("Nie posiadasz wymaganego Kamienia Duszy dla badania!")
				end
			elseif s == 3 then
				say_title("Stan badan biologicznych:")
				for i = 1, table.getn(missions) do
					local m = missions[i]
					local cur = pc.getqf("collect_count", m[1])
					if cur == nil then cur = 0 end
					if pc.get_level() >= m[6] then
						say(m[5] .. ": " .. cur .. " / " .. m[3] .. " (W plecaku: " .. pc.count_item(m[2]) .. ")")
					end
				end
			end
		end
	end
end
