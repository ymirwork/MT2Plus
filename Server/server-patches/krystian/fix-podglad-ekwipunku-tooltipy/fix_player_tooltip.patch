diff --git a/templates/player.html b/templates/player.html
--- a/templates/player.html
+++ b/templates/player.html
@@ -109,15 +109,36 @@
-<script>
-// A tooltip that would be cut over the top of its panel (a long item's name) flips under the item.
-document.addEventListener('mouseover', function (ev) {
-  var slot = ev.target.closest && ev.target.closest('.equip-slot,.inv-slot,.safebox-slot,.shop-slot,.skill-slot');
-  if (!slot || slot.dataset.tipChecked === '1') return;
-  var tip = slot.querySelector('.item-tip'); if (!tip) return;
-  slot.classList.remove('tip-below');
-  var top = tip.getBoundingClientRect().top, limit = 0, p = slot.parentElement;
-  while (p && p !== document.body) {
-    var o = getComputedStyle(p); if (o.overflow !== 'visible' || o.overflowY !== 'visible') { limit = Math.max(limit, p.getBoundingClientRect().top); break; }
-    p = p.parentElement;
-  }
-  if (top < limit + 2) slot.classList.add('tip-below');
-});
-</script>
+<script>
+// Dynamiczne dopasowanie dymków przedmiotów względem viewportu (góra/dół/lewo/prawo)
+(function () {
+  function adjustTip(slot) {
+    if (!slot) return;
+    var tip = slot.querySelector('.item-tip');
+    if (!tip) return;
+
+    var sRect = slot.getBoundingClientRect();
+    var tipH = tip.offsetHeight || 200;
+    var tipW = tip.offsetWidth || 240;
+    var vh = window.innerHeight || document.documentElement.clientHeight;
+    var vw = window.innerWidth || document.documentElement.clientWidth;
+
+    var spaceAbove = sRect.top;
+    var spaceBelow = vh - sRect.bottom;
+
+    if (spaceAbove < tipH + 15 && spaceBelow >= spaceAbove) {
+      slot.classList.remove('tip-above');
+      slot.classList.add('tip-below');
+    } else if (spaceBelow < tipH + 15 && spaceAbove > spaceBelow) {
+      slot.classList.remove('tip-below');
+      slot.classList.add('tip-above');
+    }
+
+    if (!slot.classList.contains('tip-left') && !slot.classList.contains('tip-right')) {
+      var slotCenterX = sRect.left + (sRect.width / 2);
+      if (slotCenterX - (tipW / 2) < 12) {
+        slot.classList.add('tip-left');
+      } else if (slotCenterX + (tipW / 2) > vw - 12) {
+        slot.classList.add('tip-right');
+      }
+    }
+  }
+
+  document.addEventListener('mouseover', function (ev) {
+    var slot = ev.target && ev.target.closest && ev.target.closest('.equip-slot,.inv-slot,.safebox-slot,.shop-slot,.skill-slot,.costume-slot,.ds-equip-slot,.ds-bag-slot');
+    if (slot) adjustTip(slot);
+  });
+})();
+</script>
